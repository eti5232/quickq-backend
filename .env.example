# ============================================
# QuickQ - משתני סביבה
# העתיקי קובץ זה לקובץ בשם .env ומלאי ערכים אמיתיים.
# לעולם אל תעלי את קובץ .env ל-GitHub!
# ============================================

# development / production / test
NODE_ENV=development

# הפורט שהשרת מאזין לו (ב-Render הוא נקבע אוטומטית)
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
# דוגמה למחשב מקומי:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickq?schema=public"

# מסד נתונים נפרד לבדיקות האוטומטיות (npm test). חייב להכיל את המילה test בשם!
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickq_test?schema=public"

# סוד לחתימת JWT - מחרוזת אקראית ארוכה (לפחות 32 תווים)
# אפשר ליצור כך: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# תוקף ה-Token (למשל 8h, 1d, 30m)
JWT_EXPIRES_IN=8h

# כתובות מורשות לגישה מהדפדפן (React). כמה כתובות - מופרדות בפסיק. * = כולן
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# אזור הזמן של המערכת
APP_TIMEZONE=Asia/Jerusalem

# סוד עבור cron-job.org (נשלח בכותרת x-cron-secret). אם ריק - הכתובת /api/jobs/send-reminders כבויה
CRON_SECRET=

# בדיקת תזכורות פנימית בזמן שהשרת ער (בשניות). 0 = כבוי
REMINDER_INTERVAL_SECONDS=60

# ---------- מייל (לא חובה) ----------
# אם SMTP_HOST ריק - המיילים לא נשלחים באמת אלא מודפסים ללוג של השרת
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="QuickQ <no-reply@example.com>"

# כתובת אתר ה-React (מופיעה בקישורים במיילים)
FRONTEND_URL=http://localhost:5173

# ---------- Seed (נתוני הדגמה) ----------
# בסביבת production ה-Seed יוצר רק מנהל על, ורק אם שני המשתנים האלה מוגדרים
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = ליצור גם נתוני הדגמה (קליניקות, לקוחות, תורים) עם הסיסמאות מהמשתנים למטה
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=
